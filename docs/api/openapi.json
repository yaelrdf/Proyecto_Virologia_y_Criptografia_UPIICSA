{
  "openapi": "3.1.1",
  "info": {
    "title": "API del nodo EQ08 · Centro de Ciberseguridad Comunitario",
    "description": "Endpoints del Estándar de Comunicación v2.0 (§10). Los errores usan application/problem+json con los códigos del Anexo B.",
    "version": "2.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/crypto/forward": {
      "post": {
        "tags": [
          "Crypto"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          }
        }
      }
    },
    "/api/crypto/inverse": {
      "post": {
        "tags": [
          "Crypto"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{jobId}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{jobId}/result": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "Node"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/certificate": {
      "get": {
        "tags": [
          "Node"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/x-pem-file": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/algorithms": {
      "get": {
        "tags": [
          "Node"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlgorithmsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/keys/{keyId}": {
      "get": {
        "tags": [
          "Node"
        ],
        "parameters": [
          {
            "name": "keyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          }
        }
      }
    },
    "/api/requests/receive": {
      "post": {
        "tags": [
          "Requests"
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReceiveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDocument"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlgorithmProfile": {
        "required": [
          "algorithmId",
          "algorithmCode",
          "variants",
          "operations",
          "secretParameters",
          "options",
          "publicParameters",
          "payloadModes",
          "maxPayloadBytes"
        ],
        "type": "object",
        "properties": {
          "algorithmId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "algorithmCode": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operations": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ProfileOperation"
            }
          },
          "secretParameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileSecret"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileOption"
            }
          },
          "publicParameters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payloadModes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxPayloadBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "AlgorithmsResponse": {
        "required": [
          "nodeId",
          "algorithms"
        ],
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "algorithms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlgorithmProfile"
            }
          }
        }
      },
      "JobAccepted": {
        "required": [
          "jobId",
          "statusUrl",
          "retryAfterSeconds"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "statusUrl": {
            "type": "string"
          },
          "retryAfterSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "JobError": {
        "required": [
          "code",
          "detail"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "JobStatusResponse": {
        "required": [
          "jobId",
          "state",
          "progressPercent"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "progressPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "resultUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobError"
              }
            ]
          }
        }
      },
      "ProblemDocument": {
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "nodeId",
          "timestampUtc"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "requestId": {
            "type": [
              "null",
              "string"
            ]
          },
          "timestampUtc": {
            "type": "string"
          }
        }
      },
      "ProfileOperation": {
        "required": [
          "name",
          "inputs"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProfileOption": {
        "required": [
          "name",
          "type"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "values": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "default": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProfileSecret": {
        "required": [
          "name",
          "type",
          "requiredFor"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "minBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "requiredFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ReceiveResponse": {
        "required": [
          "packetId",
          "status",
          "receivedAtUtc"
        ],
        "type": "object",
        "properties": {
          "packetId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "receivedAtUtc": {
            "type": "string"
          }
        }
      },
      "StatusAlgorithm": {
        "required": [
          "algorithmId",
          "algorithmCode"
        ],
        "type": "object",
        "properties": {
          "algorithmId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "algorithmCode": {
            "type": "string"
          }
        }
      },
      "StatusResponse": {
        "required": [
          "nodeId",
          "teamNumber",
          "protocolVersion",
          "status",
          "acceptingPackages",
          "httpPort",
          "algorithms",
          "certificateThumbprintSha256",
          "serverTimeUtc"
        ],
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "teamNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "protocolVersion": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "acceptingPackages": {
            "type": "boolean"
          },
          "httpPort": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "httpsPort": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "algorithms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatusAlgorithm"
            }
          },
          "certificateThumbprintSha256": {
            "type": "string"
          },
          "serverTimeUtc": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Crypto"
    },
    {
      "name": "Jobs"
    },
    {
      "name": "Node"
    },
    {
      "name": "Requests"
    }
  ]
}
